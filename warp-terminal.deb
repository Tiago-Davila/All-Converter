.io%2Fimages%2F1ygbk6d0%2Fproduction%2F06cc5a69bd64e38748ee9d80ab54456f00fe8cfd-1840x1174.png%3Fw%3D2400%26q%3D82%26fit%3Dmax%26auto%3Dformat&amp;w=1920&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F1ygbk6d0%2Fproduction%2F06cc5a69bd64e38748ee9d80ab54456f00fe8cfd-1840x1174.png%3Fw%3D2400%26q%3D82%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F1ygbk6d0%2Fproduction%2F06cc5a69bd64e38748ee9d80ab54456f00fe8cfd-1840x1174.png%3Fw%3D2400%26q%3D82%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75"/></div></div></div></div></div><div class="flex flex-col gap-4"><div class="flex items-start justify-between gap-4"><div class="flex flex-col gap-3"><div class="hidden flex items-center gap-2.5"><span aria-label="Oz Agent Platform" class="no-frame inline-flex shrink-0 items-center justify-center size-6 rounded-md" style="background-color:#BDA6F7;color:#111111"><svg viewBox="0 0 41 38" fill="currentColor" class="size-4" aria-hidden="true"><path d="M34.7078 4.23266L32.7254 8.85551L40.6335 14.391V16.9306H30.4751L26.5665 29.4319L30.4751 37.2474H26.2425L22.0098 28.7821L18.6237 32.1682H20.3168L22.8564 37.2474H18.6237L16.9306 33.8613L13.5445 37.2474H0L0.00330676 28.3489L12.4979 30.5528L1.51119 24.2088L4.05079 19.8108L15.0359 26.1515L6.88138 16.4346L10.7718 13.1708L18.9296 22.8927L14.5894 10.9669L19.3628 9.23083L23.7029 21.1534V8.46532H27.9372L25.4274 5.95714L24.5494 2.53959L28.8151 3.41754L30.4751 7.28976V3.38613L32.1682 0L34.7078 4.23266Z"></path></svg></span><span class="text-[10px] font-medium tracking-[0.28em] text-[var(--color-text-secondary)] uppercase">Oz Agent Platform</span></div><h3 class="max-w-2xl text-balance text-2xl/8 text-[var(--color-text)] sm:text-3xl/10" style="font-family:var(--font-heading);font-weight:var(--heading-weight);letter-spacing:var(--heading-letter-spacing)">Move from local to cloud development</h3></div><div class="mt-1 shrink-0"><div class="flex w-full flex-col items-stretch gap-4 sm:w-auto sm:flex-row sm:items-center"><a class="btn-wipe btn-hover inline-flex shrink-0 items-center justify-center text-sm/7 font-medium h-9 px-3 py-1 w-full sm:w-auto h-9" style="font-family:var(--btn-font-family);background:var(--btn-bg);border:var(--btn-border);color:var(--btn-text-color);padding:var(--btn-padding);border-radius:var(--btn-radius);text-transform:var(--btn-transform)" href="/oz"><span class="relative inline-flex items-center gap-1.5">Explore Oz<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-3.5" style="display:var(--btn-icon-display)" aria-hidden="true"><path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd"></path></svg></span></a></div></div></div><div data-component="Text" class="text-[var(--color-text-secondary)] max-w-xl text-[var(--color-text-secondary)]" style="font-family:var(--font-body);font-weight:var(--body-weight);font-size:var(--body-size);line-height:var(--body-line-height)"><p>A flexible platform to launch any agent into the cloud from any surface: programmatically via SDK or CLI, natively from Warp Terminal, or with seamless local to cloud handoff.</p></div></div></article><article id="home-agent-control-warp-agent" class="scroll-mt-28"><div class="mb-7 overflow-hidden rounded-[var(--radius-xl)] bg-[var(--card-bg)] shadow-sm [&amp;_[data-component=Screenshot]]:min-h-[360px]"><div data-color="none" class="relative overflow-hidden data-[color=neutral]:bg-[var(--color-surface)] data-[color=dark]:bg-[var(--color-background)] data-[color=light]:bg-[var(--color-panel)] data-[color=none]:bg-transparent data-[color=photo]:bg-[var(--color-surface)] data-[color=green]:bg-linear-to-br data-[color=green]:from-[#0a1a12] data-[color=green]:to-[#1a2a1a] data-[color=blue]:bg-linear-to-br data-[color=blue]:from-[#0a1220] data-[color=blue]:to-